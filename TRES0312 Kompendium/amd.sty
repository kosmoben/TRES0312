\newcounter{myexmcounter}[chapter]

\newenvironment{myexample}{
    \tcolorbox[blanker,breakable,left=5mm,parbox=false,
    before upper={\parindent15pt},
    after skip=10pt,
    lines before break=3,
	borderline west={1mm}{0pt}{clmscol!40!white}]
}{
